{
  "name": "seeit-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express + PostgreSQL API for the SeeIt streaming site",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node db/init.js",
    "db:seed": "node db/seed.js",
    "db:reset": "node db/init.js --drop && node db/seed.js",
    "db:setup": "node db/init.js && node db/seed.js"
  },
  "engines": { "node": ">=18.11" },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  }
}
